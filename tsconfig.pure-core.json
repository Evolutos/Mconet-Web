{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Pure core contracts may use ECMAScript built-ins but cannot depend on
    // browser globals, Node.js globals, or package-provided ambient types.
    "lib": ["ES2022"],
    "types": []
  },
  "include": [
    "packages/core-domain/src/**/*.ts",
    "packages/core-runtime/src/**/*.ts",
    "packages/core-spi/src/**/*.ts"
  ]
}
