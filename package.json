{
  "name": "mconet-web",
  "version": "0.0.0",
  "private": true,
  "description": "Protocol-driven model interaction SDK for Web and TypeScript runtimes.",
  "type": "module",
  "author": {
    "name": "Mcont",
    "email": "Mcont@gmail.com"
  },
  "copyright": "Copyright © 2026 Mcont",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:esm",
    "build:esm": "node scripts/build-esm.mjs",
    "build:types": "node scripts/build-declarations.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "package:check": "pnpm build && node scripts/pack-workspace.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "security:licenses": "node scripts/check-licenses.mjs && node scripts/check-licenses.mjs --self-test",
    "security:secrets": "node scripts/check-secrets.mjs && node scripts/check-secrets.mjs --self-test",
    "test": "vitest run --config vitest.workspace.ts",
    "test:contract": "vitest run --config vitest.contract.ts",
    "test:conformance": "vitest run --config vitest.conformance.ts",
    "test:coverage": "vitest run --coverage --config vitest.workspace.ts",
    "typecheck": "pnpm run build:types && node scripts/build-esm.mjs --check"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  }
}
